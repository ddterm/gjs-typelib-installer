{
    "name": "gjs-typelib-installer",
    "description": "Find and install packages for missing gi:// imports",
    "private": true,
    "homepage": "https://github.com/ddterm/gjs-typelib-installer",
    "bugs": "https://github.com/ddterm/gjs-typelib-installer/issues",
    "license": "MIT",
    "author": {
        "name": "Aleksandr Mezin",
        "email": "mezin.alexander@gmail.com",
        "url": "https://github.com/amezin"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ddterm/gjs-typelib-installer.git"
    },
    "type": "module",
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@girs/gio-2.0": "5.0.0",
        "@girs/gjs": "5.0.0",
        "eslint": "10.10.0",
        "eslint-config-gnome": "https://github.com/ddterm/eslint-config-gnome/archive/c479d059e8d9ea99c3b53c2ea43abf7fdb05eb51.tar.gz",
        "eslint-plugin-jsdoc": "64.5.4",
        "jsdoc": "4.0.5",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0"
    },
    "overrides": {
        "eslint-config-gnome": {
            "@eslint/js": "$@eslint/js",
            "eslint-plugin-jsdoc": "$eslint-plugin-jsdoc"
        }
    },
    "scripts": {
        "lint": "eslint",
        "eslint": "eslint",
        "tsc": "tsc",
        "typecheck": "tsc",
        "doc": "jsdoc -c jsdoc.jsonc",
        "jsdoc": "jsdoc -c jsdoc.jsonc",
        "test": "tests/test.js"
    }
